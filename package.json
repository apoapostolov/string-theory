{
  "name": "string-theory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local string-editing studio: rewrite an app's exported UI strings against real pixel budgets, then export the replacements.",
  "license": "MIT",
  "author": "Apostol Apostolov",
  "homepage": "https://github.com/apoapostolov/string-theory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apoapostolov/string-theory.git"
  },
  "keywords": [
    "ui-strings",
    "copywriting",
    "pixel-measurement",
    "line-wrap",
    "local-first",
    "string-editing"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --mode dev",
    "serve": "node scripts/serve.mjs",
    "serve:status": "node scripts/serve.mjs status",
    "serve:stop": "node scripts/serve.mjs stop",
    "serve:restart": "node scripts/serve.mjs restart",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "smoke:oauth": "node scripts/oauth-flow.mjs",
    "test:changes": "node scripts/change-prompt.test.mjs",
    "test:models": "node scripts/models.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
