{
  "name": "string-theory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Internal string rewriting studio: load an app's exported strings, rewrite each one to fit its pixel budget, export the replacements.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
